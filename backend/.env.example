# ══════════════════════════════════════════════════════════════════════
# Lumen backend — local / prod configuration
# ══════════════════════════════════════════════════════════════════════

# ── LLM ────────────────────────────────────────────────────────────────
# Emergent universal key — covers OpenAI / Anthropic / Gemini.
# Obtain a key from the Emergent platform (Profile → Universal Key).
EMERGENT_LLM_KEY=sk-emergent-xxxxxxxxxxxx

# (Optional) Direct-provider keys used as a fallback when EMERGENT_LLM_KEY
# is not set. Only the provider you actually plan to use needs a value.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5.2
LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=4096
LLM_PARALLEL_CALLS=4

# ── PostgreSQL (SQL executor, dataset registry, conversations) ──────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lumen

# ── Optional MongoDB (legacy persistence) ───────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=lumen

# ── App ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
CORS_ORIGINS=*
ENABLE_PROMETHEUS=false
