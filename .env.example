# ── Required — Emergent universal LLM key (OpenAI / Anthropic / Gemini) ──────
EMERGENT_LLM_KEY=sk-emergent-xxxxxxxxxxxxxxxxxx

# ── LLM defaults ─────────────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-5.2
LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=4096

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lumen

# ── Mongo (legacy / optional — conversation persistence) ─────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=lumen

# ── Frontend ─────────────────────────────────────────────────────────────────
REACT_APP_BACKEND_URL=http://localhost:8001

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
ENABLE_PROMETHEUS=false
