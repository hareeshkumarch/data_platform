# ── Required: at least one must be set ───────────────────────────────────────
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# ── Optional tuning ────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=4096

# ── Redis (keep defaults for Docker) ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
